@using TreeLightsWeb.ImageCapture
@{
    ViewData["Title"] = "Tree Image Capture";
}

<h1 class="display-6 mb-3">Tree Image Capture</h1>
<div class="row g-4">
    <div class="col-lg-7">
        <video autoplay muted playsinline id="camera" class="w-100 rounded border bg-dark"></video>
        <div id="cameraInfo" class="small text-break text-muted">Starting the camera…</div>
        <div class="row g-2 mt-1">
            <div class="col-sm-7">
                <label for="cameraSelect" class="form-label small mb-0">Camera</label>
                <select id="cameraSelect" class="form-select form-select-sm">
                    <option value="">Default camera</option>
                </select>
            </div>
            <div class="col-sm-5">
                <label for="resolutionSelect" class="form-label small mb-0">Resolution</label>
                <select id="resolutionSelect" class="form-select form-select-sm">
                    <option value="">Camera default</option>
                    <option value="1280x720">1280 × 720</option>
                    <option value="1920x1080">1920 × 1080</option>
                </select>
            </div>
        </div>
        <div class="mt-2">
            <button type="button" id="lightTreeButton" class="btn btn-outline-secondary btn-sm">Light the whole tree</button>
            <span class="small text-muted ms-1">to line the camera up</span>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h6 mb-1">Directions</h2>
        <table id="directionsTable" class="table table-sm table-hover small mb-1">
            <thead><tr><th>Direction</th><th>Images</th><th>Captured</th></tr></thead>
            <tbody></tbody>
        </table>
        <div class="form-text mt-0 mb-2">Capture each direction once, rotating the whole tree 45° between captures. Click a row to select it.</div>

        <div class="row g-2">
            <div class="col-6">igravity
                <label for="direction" class="form-label small mb-0">Direction</label>
                <select id="direction" class="form-select">
                    @foreach (var direction in CaptureDirections.All)
                    {
                        <option value="@direction">@(direction)°</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <label for="settleDelay" class="form-label small mb-0">Settle delay (ms)</label>
                <input id="settleDelay" type="number" min="0" max="10000" step="10" value="200" class="form-control" />
            </div>
            <div class="col-12 form-text mt-1">
                How long after each LED changes the frame is taken. The shorter it is the faster the capture, but too short
                and the camera will still be showing the previous LED.
            </div>
            <div class="col-12">
                <button type="button" id="measureButton" class="btn btn-outline-primary btn-sm" disabled>Measure camera latency</button>
                <span id="latencyResult" class="small ms-1"></span>
            </div>
            <div class="col-6">
                <label for="exposureSettle" class="form-label small mb-0">Exposure settle (ms)</label>
                <input id="exposureSettle" type="number" min="0" max="30000" step="100" value="1500" class="form-control" />
            </div>
            <div class="col-6 form-text align-self-end">
                Pause before the first LED, while the camera's auto-exposure adjusts after the whole tree was lit.
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" id="startButton" class="btn btn-primary" disabled>Capture images</button>
            <button type="button" id="resumeButton" class="btn btn-outline-primary d-none" disabled>Resume</button>
            <button type="button" id="stopButton" class="btn btn-outline-danger" disabled>Stop</button>
        </div>

        <div class="mt-3">
            <div class="progress"><div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div></div>
            <div id="progressText" class="small text-muted mt-1">&nbsp;</div>
            <div id="statusMessage" class="alert alert-secondary small py-2 mt-2 mb-2" role="status">Connecting…</div>
            <div id="connectionInfo" class="small text-danger"></div>
            <ul id="log" class="small text-muted ps-3 mb-0"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.js"></script>
    <script>
        window.imageCaptureConfig = {
            hubUrl: '/imagecapturehub',
            startUrl: '@Url.Action("Start", "ImageCapture")',
            stopUrl: '@Url.Action("Stop", "ImageCapture")',
            measureLatencyUrl: '@Url.Action("MeasureLatency", "ImageCapture")',
            lightTreeUrl: '@Url.Action("LightTree", "ImageCapture")',
            summaryUrl: '@Url.Action("Summary", "ImageCapture")',
            uploadUrl: '@Url.Action("UploadImage", "ImageCapture")',
            processingUrl: '@Url.Action("Index", "ImageProcessing")'
        };
    </script>
    <script src="~/js/imagecapture.js" asp-append-version="true"></script>
}