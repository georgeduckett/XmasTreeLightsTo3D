@{
    ViewData["Title"] = "Configuration";
}

<h1 class="display-6 mb-4">Configuration</h1>
<div id="configError" class="alert alert-danger d-none" role="alert"></div>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h4 card-title">Which side faces the room</h2>
        <p>
            Scrolling text and pictures are shown on the side of the tree that faces the room. Stand where you usually see
            the tree from and press <b>Show guide</b>: the tree lights the side it thinks is the front, with a big F on it.
            Move the slider until the F faces you. If the F reads backwards, tick <b>Mirror image</b>. Then save.
        </p>
        <div class="row g-3 align-items-center">
            <div class="col-md-7">
                <label for="frontDirection" class="form-label">
                    Front: <span id="frontDirectionValue">0</span>° round from the side the camera saw first
                </label>
                <input type="range" class="form-range" id="frontDirection" min="0" max="355" step="5" value="0" />
            </div>
            <div class="col-md-5">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="mirrored" />
                    <label class="form-check-label" for="mirrored">Mirror image (the F reads backwards)</label>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" id="showGuide" class="btn btn-outline-dark">Show guide on the tree</button>
            <button type="button" id="saveOrientation" class="btn btn-dark">Save</button>
            <button type="button" id="stopGuide" class="btn btn-outline-secondary">Stop the guide</button>
        </div>
        <p id="orientationStatus" class="text-muted small mt-2 mb-0"></p>
    </div>
</section>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h4 card-title">Colour palette</h2>
        <p>
            The animations take their colours from the palette in use, so switching palette (for a new season, say) changes
            them all, including one that's running, apart from any you've given their own colours (below). Animations that
            need one or two colours use the first ones (Snake's apple is the first colour and the snake the second), and
            the colourful ones go through them all. Fire, Lightning, Snowfall, Orbiting Sun, Pictures, Sweep Planes, Binary
            and Six have colours of their own whatever the palette.
        </p>
        <div id="palettes" class="row g-3"></div>
        <button type="button" id="newPalette" class="btn btn-outline-dark mt-3">New palette</button>
    </div>
</section>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h4 card-title">Animation colours</h2>
        <p>
            Some animations have colours for particular things, like the snake's head, body and apple. Usually these come
            from the palette in use (or, for Fire, Lightning, Snowfall and Orbiting Sun, are colours of their own). Switch on
            <b>Own colours</b> to choose them yourself: they then stay the same whatever palette's in use. Changes show on
            the tree straight away, so press <b>Show on tree</b> to watch while you choose.
        </p>
        <div id="animationColours" class="row g-3"></div>
    </div>
</section>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h4 card-title">Showcase</h2>
        <p>The animations the Showcase goes through, in a random order. Changes apply from its next animation.</p>
        <div id="showcaseEffects" class="row row-cols-2 row-cols-md-4 g-2"></div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <button type="button" id="showcaseAll" class="btn btn-sm btn-outline-secondary">All</button>
            <button type="button" id="showcaseNone" class="btn btn-sm btn-outline-secondary">None</button>
            <label for="secondsEach" class="ms-md-3">Seconds each</label>
            <input type="number" id="secondsEach" class="form-control w-auto" min="5" max="600" />
            <button type="button" id="saveShowcase" class="btn btn-dark">Save</button>
        </div>
        <p id="showcaseStatus" class="text-muted small mt-2 mb-0"></p>
    </div>
</section>

@section Scripts {
    <script src="~/js/configuration.js" asp-append-version="true"></script>
}
